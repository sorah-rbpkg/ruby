#!/bin/sh

set -eu

standalone=$(sed -e '/^#/d' ${0}.reject | awk -v d='\\|' '{s=(NR==1?s:s d)$0}END{print s}' )

printf 'libruby:Provides='
find "$@" -name \*.gemspec \
	| xargs -n 1 basename \
	| sort \
	| grep -v "${standalone}" \
	| sed -e 's/_/-/g; s/\(.*\)-\([0-9.]\+\)\.gemspec/ruby-\1 (= \2), /' | xargs echo
