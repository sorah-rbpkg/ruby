From: Christian Hofstaedtler <zeha@debian.org>
Date: Tue, 10 Oct 2017 15:04:34 -0300
Subject: rdoc: build reproducible documentation

- sort input filenames
- provide a fixed timestamp to the gzip compression

Signed-off-by: Antonio Terceiro <terceiro@debian.org>
Signed-off-by: Christian Hofstaedtler <zeha@debian.org>
---
 .bundle/gems/rdoc-8.1.0/lib/rdoc/generator/json_index.rb | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/.bundle/gems/rdoc-8.1.0/lib/rdoc/generator/json_index.rb b/.bundle/gems/rdoc-8.1.0/lib/rdoc/generator/json_index.rb
index cd4ea68..9470adc 100644
--- a/.bundle/gems/rdoc-8.1.0/lib/rdoc/generator/json_index.rb
+++ b/.bundle/gems/rdoc-8.1.0/lib/rdoc/generator/json_index.rb
@@ -178,7 +178,7 @@ module RDoc
         debug_msg "Writing gzipped search index to %s" % outfile
 
         Zlib::GzipWriter.open(outfile) do |gz|
-          gz.mtime = File.mtime(search_index_file)
+          gz.mtime = -1
           gz.orig_name = search_index_file.basename.to_s
           gz.write search_index
           gz.close
@@ -196,7 +196,7 @@ module RDoc
             debug_msg "Writing gzipped file to %s" % outfile
 
             Zlib::GzipWriter.open(outfile) do |gz|
-              gz.mtime = File.mtime(dest)
+              gz.mtime = -1
               gz.orig_name = dest.basename.to_s
               gz.write data
               gz.close
