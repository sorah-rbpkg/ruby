From: Sorah Fukumori <her@sorah.jp>
Date: Sat, 24 Oct 2026 20:58:31 +0900
Subject: test_gem_credential_store_*: run fake backends with Gem.ruby

The fake backends used "#!/usr/bin/env ruby", which fails where no
unsuffixed ruby is on PATH, as in a build with --program-suffix.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GJ3bNSvV7ut2Ks61oEAsUx
---
 test/rubygems/test_gem_credential_store_linux_backend.rb   | 2 +-
 test/rubygems/test_gem_credential_store_macos_backend.rb   | 4 ++--
 test/rubygems/test_gem_credential_store_windows_backend.rb | 2 +-
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/test/rubygems/test_gem_credential_store_linux_backend.rb b/test/rubygems/test_gem_credential_store_linux_backend.rb
index f00c545..d7c1058 100644
--- a/test/rubygems/test_gem_credential_store_linux_backend.rb
+++ b/test/rubygems/test_gem_credential_store_linux_backend.rb
@@ -33,7 +33,7 @@ class TestGemCredentialStoreLinuxBackend < Gem::TestCase
     @fake_bin_dir = File.join(@tempdir, "fake-bin")
     FileUtils.mkdir_p(@fake_bin_dir)
     fake_path = File.join(@fake_bin_dir, "secret-tool")
-    File.write(fake_path, FAKE_COMMAND)
+    File.write(fake_path, FAKE_COMMAND.sub("/usr/bin/env ruby", Gem.ruby))
     File.chmod(0o755, fake_path)
 
     @record_path = File.join(@tempdir, "record.json")
diff --git a/test/rubygems/test_gem_credential_store_macos_backend.rb b/test/rubygems/test_gem_credential_store_macos_backend.rb
index 560f4c8..26c6913 100644
--- a/test/rubygems/test_gem_credential_store_macos_backend.rb
+++ b/test/rubygems/test_gem_credential_store_macos_backend.rb
@@ -25,7 +25,7 @@ class TestGemCredentialStoreMacosBackend < Gem::TestCase
     @fake_bin_dir = File.join(@tempdir, "fake-bin")
     FileUtils.mkdir_p(@fake_bin_dir)
     fake_path = File.join(@fake_bin_dir, "security")
-    File.write(fake_path, FAKE_COMMAND)
+    File.write(fake_path, FAKE_COMMAND.sub("/usr/bin/env ruby", Gem.ruby))
     File.chmod(0o755, fake_path)
 
     @record_path = File.join(@tempdir, "record.json")
@@ -160,7 +160,7 @@ class TestGemCredentialStoreMacosBackend < Gem::TestCase
     counter = File.join(@tempdir, "counter")
     File.write(counter, "0")
     script = <<~RUBY
-      #!/usr/bin/env ruby
+      #!#{Gem.ruby}
       c = File.read(#{counter.inspect}).to_i
       File.write(#{counter.inspect}, (c + 1).to_s)
       exit(c < 2 ? 0 : 44)
diff --git a/test/rubygems/test_gem_credential_store_windows_backend.rb b/test/rubygems/test_gem_credential_store_windows_backend.rb
index 0a8e75c..c19bd75 100644
--- a/test/rubygems/test_gem_credential_store_windows_backend.rb
+++ b/test/rubygems/test_gem_credential_store_windows_backend.rb
@@ -36,7 +36,7 @@ class TestGemCredentialStoreWindowsBackend < Gem::TestCase
     @fake_bin_dir = File.join(@tempdir, "fake-bin")
     FileUtils.mkdir_p(@fake_bin_dir)
     fake_path = File.join(@fake_bin_dir, "powershell")
-    File.write(fake_path, FAKE_COMMAND)
+    File.write(fake_path, FAKE_COMMAND.sub("/usr/bin/env ruby", Gem.ruby))
     File.chmod(0o755, fake_path)
 
     # A shebang does not make a file executable on Windows. PATHEXT finds the
