  569 p_kwrest: kwrest_mark "local variable or method"
  570         | kwrest_mark

  571 p_kwnorest: kwrest_mark "'nil'"

  572 p_any_kwrest: p_kwrest
  573             | p_kwnorest

  574 p_value: p_primitive
  575        | p_primitive ".." p_primitive
  576        | p_primitive "..." p_primitive
  577        | p_primitive ".."
  578        | p_primitive "..."
  579        | p_var_ref
  580        | p_expr_ref
  581        | p_const
  582        | "(.." p_primitive
  583        | "(..." p_primitive

  584 p_primitive: literal
  585            | strings
  586            | xstring
  587            | regexp
  588            | words
  589            | qwords
  590            | symbols
