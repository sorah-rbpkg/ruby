Grammar

    0 $accept: program "end-of-input"

    1 $@1: ε

    2 program: $@1 top_compstmt

    3 option_terms: ε
    4             | terms

    5 top_compstmt: top_stmts option_terms

    6 top_stmts: none
    7          | top_stmt
    8          | top_stmts terms top_stmt

    9 top_stmt: stmt
   10         | "'BEGIN'" begin_block

   11 block_open: '{'

   12 begin_block: block_open top_compstmt '}'

   13 $@2: ε

   14 $@3: ε

   15 bodystmt: compstmt lex_ctxt opt_rescue k_else $@2 compstmt $@3 opt_ensure

   16 $@4: ε

   17 bodystmt: compstmt lex_ctxt opt_rescue $@4 opt_ensure

   18 compstmt: stmts option_terms

   19 stmts: none
   20      | stmt_or_begin
   21      | stmts terms stmt_or_begin

   22 stmt_or_begin: stmt

   23 $@5: ε

   24 stmt_or_begin: "'BEGIN'" $@5 begin_block

   25 allow_exits: ε

   26 k_END: "'END'" lex_ctxt

   27 $@6: ε

   28 stmt: "'alias'" fitem $@6 fitem
   29     | "'alias'" "global variable" "global variable"
   30     | "'alias'" "global variable" "back reference"
   31     | "'alias'" "global variable" "numbered reference"
   32     | "'undef'" undef_list
   33     | stmt "'if' modifier" expr_value
   34     | stmt "'unless' modifier" expr_value
   35     | stmt "'while' modifier" expr_value
   36     | stmt "'until' modifier" expr_value
   37     | stmt "'rescue' modifier" after_rescue stmt
   38     | k_END allow_exits '{' compstmt '}'
   39     | command_asgn
   40     | mlhs '=' lex_ctxt command_call
   41     | lhs '=' lex_ctxt mrhs
   42     | mlhs '=' lex_ctxt mrhs_arg "'rescue' modifier" after_rescue stmt
   43     | mlhs '=' lex_ctxt mrhs_arg
   44     | expr
   45     | error

   46 command_asgn: lhs '=' lex_ctxt command_rhs
   47             | var_lhs "operator-assignment" lex_ctxt command_rhs
   48             | primary_value '[' opt_call_args rbracket "operator-assignment" lex_ctxt command_rhs
   49             | primary_value call_op "local variable or method" "operator-assignment" lex_ctxt command_rhs
   50             | primary_value call_op "constant" "operator-assignment" lex_ctxt command_rhs
   51             | primary_value "::" "constant" "operator-assignment" lex_ctxt command_rhs
   52             | primary_value "::" "local variable or method" "operator-assignment" lex_ctxt command_rhs
   53             | ":: at EXPR_BEG" "constant" "operator-assignment" lex_ctxt command_rhs
   54             | defn_head f_opt_paren_args '=' endless_command
   55             | defs_head f_opt_paren_args '=' endless_command
   56             | backref "operator-assignment" lex_ctxt command_rhs

   57 endless_command: command
   58                | endless_command "'rescue' modifier" after_rescue arg

   59 option_'\n': ε
   60            | '\n'

   61 endless_command: "'not'" option_'\n' endless_command

   62 command_rhs: command_call
   63            | command_call "'rescue' modifier" after_rescue stmt
   64            | command_asgn

   65 expr: command_call
   66     | expr "'and'" expr
   67     | expr "'or'" expr
   68     | "'not'" option_'\n' expr
   69     | '!' command_call

   70 $@7: ε

   71 expr: arg "=>" $@7 p_in_kwarg p_pvtbl p_pktbl p_top_expr_body

   72 $@8: ε

   73 expr: arg "'in'" $@8 p_in_kwarg p_pvtbl p_pktbl p_top_expr_body
   74     | arg

   75 def_name: fname

   76 defn_head: k_def def_name

   77 $@9: ε

   78 defs_head: k_def singleton dot_or_colon $@9 def_name

   79 expr_value: expr
   80           | error

   81 $@10: ε

   82 $@11: ε

   83 expr_value_do: $@10 expr_value do $@11

   84 command_call: command
   85             | block_command

   86 block_command: block_call
   87              | block_call call_op2 operation2 command_args

   88 cmd_brace_block: "{ arg" brace_body '}'

   89 fcall: operation

   90 command: fcall command_args
   91        | fcall command_args cmd_brace_block
   92        | primary_value call_op operation2 command_args
   93        | primary_value call_op operation2 command_args cmd_brace_block
   94        | primary_value "::" operation2 command_args
   95        | primary_value "::" operation2 command_args cmd_brace_block
   96        | primary_value "::" "constant" '{' brace_body '}'
   97        | "'super'" command_args
   98        | k_yield command_args
   99        | k_return_arg call_args
  100        | k_break_arg call_args
  101        | k_next_arg call_args

  102 mlhs: mlhs_basic
  103     | "(" mlhs_inner rparen

  104 mlhs_inner: mlhs_basic
  105           | "(" mlhs_inner rparen

  106 mlhs_basic: mlhs_head
  107           | mlhs_head mlhs_item
  108           | mlhs_head "*" mlhs_node
  109           | mlhs_head "*" mlhs_node ',' mlhs_post
  110           | mlhs_head "*"
  111           | mlhs_head "*" ',' mlhs_post
  112           | "*" mlhs_node
  113           | "*" mlhs_node ',' mlhs_post
  114           | "*"
  115           | "*" ',' mlhs_post

  116 mlhs_item: mlhs_node
  117          | "(" mlhs_inner rparen

  118 mlhs_head: mlhs_item ','
  119          | mlhs_head mlhs_item ','

  120 mlhs_post: mlhs_item
  121          | mlhs_post ',' mlhs_item

  122 mlhs_node: user_variable
  123          | keyword_variable
  124          | primary_value '[' opt_call_args rbracket
  125          | primary_value call_op "local variable or method"
  126          | primary_value "::" "local variable or method"
  127          | primary_value call_op "constant"
  128          | primary_value "::" "constant"
  129          | ":: at EXPR_BEG" "constant"
  130          | backref

  131 lhs: user_variable
  132    | keyword_variable
  133    | primary_value '[' opt_call_args rbracket
  134    | primary_value call_op "local variable or method"
  135    | primary_value "::" "local variable or method"
  136    | primary_value call_op "constant"
  137    | primary_value "::" "constant"
  138    | ":: at EXPR_BEG" "constant"
  139    | backref

  140 cname: "local variable or method"
  141      | "constant"

  142 cpath: ":: at EXPR_BEG" cname
  143      | cname
  144      | primary_value "::" cname

  145 fname: "local variable or method"
  146      | "constant"
  147      | "method"
  148      | op
  149      | reswords

  150 fitem: fname
  151      | symbol

  152 undef_list: fitem

  153 $@12: ε

  154 undef_list: undef_list ',' $@12 fitem

  155 op: '|'
  156   | '^'
  157   | '&'
  158   | "<=>"
  159   | "=="
  160   | "==="
  161   | "=~"
  162   | "!~"
  163   | '>'
  164   | ">="
  165   | '<'
  166   | "<="
  167   | "!="
  168   | "<<"
  169   | ">>"
  170   | '+'
  171   | '-'
  172   | '*'
  173   | "*"
  174   | '/'
  175   | '%'
  176   | "**"
  177   | "**arg"
  178   | '!'
  179   | '~'
  180   | "unary+"
  181   | "unary-"
  182   | "[]"
  183   | "[]="
  184   | '`'

  185 reswords: "'__LINE__'"
  186         | "'__FILE__'"
  187         | "'__ENCODING__'"
  188         | "'BEGIN'"
  189         | "'END'"
  190         | "'alias'"
  191         | "'and'"
  192         | "'begin'"
  193         | "'break'"
  194         | "'case'"
  195         | "'class'"
  196         | "'def'"
  197         | "'defined?'"
  198         | "'do'"
  199         | "'else'"
  200         | "'elsif'"
  201         | "'end'"
  202         | "'ensure'"
  203         | "'false'"
  204         | "'for'"
  205         | "'in'"
  206         | "'module'"
  207         | "'next'"
  208         | "'nil'"
  209         | "'not'"
  210         | "'or'"
  211         | "'redo'"
  212         | "'rescue'"
  213         | "'retry'"
  214         | "'return'"
  215         | "'self'"
  216         | "'super'"
  217         | "'then'"
  218         | "'true'"
  219         | "'undef'"
  220         | "'when'"
  221         | "'yield'"
  222         | "'if'"
  223         | "'unless'"
  224         | "'while'"
  225         | "'until'"

  226 arg: lhs '=' lex_ctxt arg_rhs
  227    | var_lhs "operator-assignment" lex_ctxt arg_rhs
  228    | primary_value '[' opt_call_args rbracket "operator-assignment" lex_ctxt arg_rhs
  229    | primary_value call_op "local variable or method" "operator-assignment" lex_ctxt arg_rhs
  230    | primary_value call_op "constant" "operator-assignment" lex_ctxt arg_rhs
  231    | primary_value "::" "local variable or method" "operator-assignment" lex_ctxt arg_rhs
  232    | primary_value "::" "constant" "operator-assignment" lex_ctxt arg_rhs
  233    | ":: at EXPR_BEG" "constant" "operator-assignment" lex_ctxt arg_rhs
  234    | backref "operator-assignment" lex_ctxt arg_rhs
  235    | arg ".." arg
  236    | arg "..." arg
  237    | arg ".."
  238    | arg "..."
  239    | "(.." arg
  240    | "(..." arg
  241    | arg '+' arg
  242    | arg '-' arg
  243    | arg '*' arg
  244    | arg '/' arg
  245    | arg '%' arg
  246    | arg "**" arg
  247    | tUMINUS_NUM simple_numeric "**" arg
  248    | "unary+" arg
  249    | "unary-" arg
  250    | arg '|' arg
  251    | arg '^' arg
  252    | arg '&' arg
  253    | arg "<=>" arg
  254    | rel_expr
  255    | arg "==" arg
  256    | arg "===" arg
  257    | arg "!=" arg
  258    | arg "=~" arg
  259    | arg "!~" arg
  260    | '!' arg
  261    | '~' arg
  262    | arg "<<" arg
  263    | arg ">>" arg
  264    | arg "&&" arg
  265    | arg "||" arg
  266    | "'defined?'" option_'\n' begin_defined arg
  267    | arg '?' arg option_'\n' ':' arg
  268    | defn_head f_opt_paren_args '=' endless_arg
  269    | defs_head f_opt_paren_args '=' endless_arg
  270    | primary

  271 endless_arg: arg
  272            | endless_arg "'rescue' modifier" after_rescue arg
  273            | "'not'" option_'\n' endless_arg

  274 relop: '>'
  275      | '<'
  276      | ">="
  277      | "<="

  278 rel_expr: arg relop arg
  279         | rel_expr relop arg

  280 lex_ctxt: none

  281 begin_defined: lex_ctxt

  282 after_rescue: lex_ctxt

  283 arg_value: arg

  284 aref_args: none
  285          | args trailer
  286          | args ',' assocs trailer
  287          | assocs trailer

  288 arg_rhs: arg
  289        | arg "'rescue' modifier" after_rescue arg

  290 paren_args: '(' opt_call_args rparen
  291           | '(' args ',' args_forward rparen
  292           | '(' args_forward rparen

  293 opt_paren_args: none
  294               | paren_args

  295 opt_call_args: none
  296              | call_args
  297              | args ','
  298              | args ',' assocs ','
  299              | assocs ','

  300 call_args: command
  301          | args opt_block_arg
  302          | assocs opt_block_arg
  303          | args ',' assocs opt_block_arg
  304          | block_arg

  305 $@13: ε

  306 command_args: $@13 call_args

  307 block_arg: "&" arg_value
  308          | "&"

  309 opt_block_arg: ',' block_arg
  310              | none

  311 args: arg_value
  312     | arg_splat
  313     | args ',' arg_value
  314     | args ',' arg_splat

  315 arg_splat: "*" arg_value
  316          | "*"

  317 mrhs_arg: mrhs
  318         | arg_value

  319 mrhs: args ',' arg_value
  320     | args ',' "*" arg_value
  321     | "*" arg_value

  322 primary: literal
  323        | strings
  324        | xstring
  325        | regexp
  326        | words
  327        | qwords
  328        | symbols
  329        | qsymbols
  330        | var_ref
  331        | backref
  332        | "method"

  333 $@14: ε

  334 primary: k_begin $@14 bodystmt k_end

  335 $@15: ε

  336 primary: "( arg" compstmt $@15 ')'
  337        | "(" compstmt ')'
  338        | primary_value "::" "constant"
  339        | ":: at EXPR_BEG" "constant"
  340        | "[" aref_args ']'
  341        | "{" assoc_list '}'
  342        | k_return
  343        | k_yield '(' call_args rparen
  344        | k_yield '(' rparen
  345        | k_yield
  346        | "'defined?'" option_'\n' '(' begin_defined expr rparen
  347        | "'not'" '(' expr rparen
  348        | "'not'" '(' rparen
  349        | fcall brace_block
  350        | method_call
  351        | method_call brace_block
  352        | lambda
  353        | k_if expr_value then compstmt if_tail k_end
  354        | k_unless expr_value then compstmt opt_else k_end
  355        | k_while expr_value_do compstmt k_end
  356        | k_until expr_value_do compstmt k_end

  357 @16: ε

  358 primary: k_case expr_value option_terms @16 case_body k_end

  359 @17: ε

  360 primary: k_case option_terms @17 case_body k_end
  361        | k_case expr_value option_terms p_case_body k_end
  362        | k_for for_var "'in'" expr_value_do compstmt k_end

  363 $@18: ε

  364 primary: k_class cpath superclass $@18 bodystmt k_end

  365 $@19: ε

  366 primary: k_class "<<" expr_value $@19 term bodystmt k_end

  367 $@20: ε

  368 primary: k_module cpath $@20 bodystmt k_end

  369 $@21: ε

  370 primary: defn_head f_arglist $@21 bodystmt k_end

  371 $@22: ε

  372 primary: defs_head f_arglist $@22 bodystmt k_end
  373        | "'break'"
  374        | "'next'"
  375        | "'redo'"
  376        | "'retry'"

  377 primary_value: primary

  378 k_begin: "'begin'"

  379 k_if: "'if'"

  380 k_unless: "'unless'"

  381 k_while: "'while'" allow_exits

  382 k_until: "'until'" allow_exits

  383 k_case: "'case'"

  384 k_for: "'for'" allow_exits

  385 k_class: "'class'"

  386 k_module: "'module'"

  387 k_def: "'def'"

  388 k_do: "'do'"

  389 k_do_block: "'do' for block"

  390 k_rescue: "'rescue'"

  391 k_ensure: "'ensure'"

  392 k_when: "'when'"

  393 k_else: "'else'"

  394 k_elsif: "'elsif'"

  395 k_end: "'end'"
  396      | "dummy end"

  397 k_return: "'return'"

  398 k_return_arg: k_return

  399 k_break_arg: "'break'"

  400 k_next_arg: "'next'"

  401 k_yield: "'yield'"

  402 then: term
  403     | "'then'"
  404     | term "'then'"

  405 do: term
  406   | "'do' for condition"

  407 if_tail: opt_else
  408        | k_elsif expr_value then compstmt if_tail

  409 opt_else: none
  410         | k_else compstmt

  411 for_var: lhs
  412        | mlhs

  413 f_marg: f_norm_arg
  414       | "(" f_margs rparen

  415 f_marg_list: f_marg
  416            | f_marg_list ',' f_marg

  417 f_margs: f_marg_list
  418        | f_marg_list ',' f_rest_marg
  419        | f_marg_list ',' f_rest_marg ',' f_marg_list
  420        | f_rest_marg
  421        | f_rest_marg ',' f_marg_list

  422 f_rest_marg: "*" f_norm_arg
  423            | "*"

  424 f_any_kwrest: f_kwrest
  425             | f_no_kwarg

  426 $@23: ε

  427 f_eq: $@23 '='

  428 f_kwarg_f_block_kw: f_block_kw
  429                   | f_kwarg_f_block_kw ',' f_block_kw

  430 block_args_tail: f_kwarg_f_block_kw ',' f_kwrest opt_f_block_arg
  431                | f_kwarg_f_block_kw opt_f_block_arg
  432                | f_any_kwrest opt_f_block_arg
  433                | f_block_arg

  434 excessed_comma: ','

  435 f_opt_primary_value: f_arg_asgn f_eq primary_value

  436 f_optarg_primary_value: f_opt_primary_value
  437                       | f_optarg_primary_value ',' f_opt_primary_value

  438 opt_args_tail_block_args_tail: ',' block_args_tail
  439                              | ε

  440 block_param: f_arg ',' f_optarg_primary_value ',' f_rest_arg opt_args_tail_block_args_tail
  441            | f_arg ',' f_optarg_primary_value ',' f_rest_arg ',' f_arg opt_args_tail_block_args_tail
  442            | f_arg ',' f_optarg_primary_value opt_args_tail_block_args_tail
  443            | f_arg ',' f_optarg_primary_value ',' f_arg opt_args_tail_block_args_tail
  444            | f_arg ',' f_rest_arg opt_args_tail_block_args_tail
  445            | f_arg excessed_comma
  446            | f_arg ',' f_rest_arg ',' f_arg opt_args_tail_block_args_tail
  447            | f_arg opt_args_tail_block_args_tail
  448            | f_optarg_primary_value ',' f_rest_arg opt_args_tail_block_args_tail
  449            | f_optarg_primary_value ',' f_rest_arg ',' f_arg opt_args_tail_block_args_tail
  450            | f_optarg_primary_value opt_args_tail_block_args_tail
  451            | f_optarg_primary_value ',' f_arg opt_args_tail_block_args_tail
  452            | f_rest_arg opt_args_tail_block_args_tail
  453            | f_rest_arg ',' f_arg opt_args_tail_block_args_tail
  454            | block_args_tail

  455 opt_block_param: none
  456                | block_param_def

  457 block_param_def: '|' opt_bv_decl '|'
  458                | '|' block_param opt_bv_decl '|'

  459 opt_bv_decl: option_'\n'
  460            | option_'\n' ';' bv_decls option_'\n'

  461 bv_decls: bvar
  462         | bv_decls ',' bvar

  463 bvar: "local variable or method"
  464     | f_bad_arg

  465 max_numparam: ε

  466 numparam: ε

  467 it_id: ε

  468 @24: ε

  469 $@25: ε

  470 lambda: "->" @24 max_numparam numparam it_id allow_exits f_larglist $@25 lambda_body

  471 f_larglist: '(' f_args opt_bv_decl ')'
  472           | f_args

  473 lambda_body: tLAMBEG compstmt '}'

  474 $@26: ε

  475 lambda_body: "'do' for lambda" $@26 bodystmt k_end

  476 do_block: k_do_block do_body k_end

  477 block_call: command do_block
  478           | block_call call_op2 operation2 opt_paren_args
  479           | block_call call_op2 operation2 opt_paren_args brace_block
  480           | block_call call_op2 operation2 command_args do_block

  481 method_call: fcall paren_args
  482            | primary_value call_op operation2 opt_paren_args
  483            | primary_value "::" operation2 paren_args
  484            | primary_value "::" operation3
  485            | primary_value call_op paren_args
  486            | primary_value "::" paren_args
  487            | "'super'" paren_args
  488            | "'super'"
  489            | primary_value '[' opt_call_args rbracket

  490 brace_block: '{' brace_body '}'
  491            | k_do do_body k_end

  492 @27: ε

  493 brace_body: @27 max_numparam numparam it_id allow_exits opt_block_param compstmt

  494 @28: ε

  495 do_body: @28 max_numparam numparam it_id allow_exits opt_block_param bodystmt

  496 case_args: arg_value
  497          | "*" arg_value
  498          | case_args ',' arg_value
  499          | case_args ',' "*" arg_value

  500 case_body: k_when case_args then compstmt cases

  501 cases: opt_else
  502      | case_body

  503 p_pvtbl: ε

  504 p_pktbl: ε

  505 p_in_kwarg: ε

  506 $@29: ε

  507 p_case_body: "'in'" p_in_kwarg p_pvtbl p_pktbl p_top_expr then $@29 compstmt p_cases

  508 p_cases: opt_else
  509        | p_case_body

  510 p_top_expr: p_top_expr_body
  511           | p_top_expr_body "'if' modifier" expr_value
  512           | p_top_expr_body "'unless' modifier" expr_value

  513 p_top_expr_body: p_expr
  514                | p_expr ','
  515                | p_expr ',' p_args
  516                | p_find
  517                | p_args_tail
  518                | p_kwargs

  519 p_expr: p_as

  520 p_as: p_expr "=>" p_variable
  521     | p_alt

  522 p_alt: p_alt '|' p_expr_basic
  523      | p_expr_basic

  524 p_lparen: '(' p_pktbl

  525 p_lbracket: '[' p_pktbl

  526 p_expr_basic: p_value
  527             | p_variable
  528             | p_const p_lparen p_args rparen
  529             | p_const p_lparen p_find rparen
  530             | p_const p_lparen p_kwargs rparen
  531             | p_const '(' rparen
  532             | p_const p_lbracket p_args rbracket
  533             | p_const p_lbracket p_find rbracket
  534             | p_const p_lbracket p_kwargs rbracket
  535             | p_const '[' rbracket
  536             | "[" p_args rbracket
  537             | "[" p_find rbracket
  538             | "[" rbracket

  539 $@30: ε

  540 p_expr_basic: "{" p_pktbl lex_ctxt $@30 p_kwargs rbrace
  541             | "{" rbrace
  542             | "(" p_pktbl p_expr rparen

  543 p_args: p_expr
  544       | p_args_head
  545       | p_args_head p_arg
  546       | p_args_head p_rest
  547       | p_args_head p_rest ',' p_args_post
  548       | p_args_tail

  549 p_args_head: p_arg ','
  550            | p_args_head p_arg ','

  551 p_args_tail: p_rest
  552            | p_rest ',' p_args_post

  553 p_find: p_rest ',' p_args_post ',' p_rest

  554 p_rest: "*" "local variable or method"
  555       | "*"

  556 p_args_post: p_arg
  557            | p_args_post ',' p_arg

  558 p_arg: p_expr

  559 p_kwargs: p_kwarg ',' p_any_kwrest
  560         | p_kwarg
  561         | p_kwarg ','
  562         | p_any_kwrest

  563 p_kwarg: p_kw
  564        | p_kwarg ',' p_kw

  565 p_kw: p_kw_label p_expr
  566     | p_kw_label

  567 p_kw_label: "label"
